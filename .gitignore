# Python virtual environments and cache
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local credentials / environment files
.env
*.env

# Local/private config
config/local-*.yaml

# Runtime data
data/*.sqlite3
data/*.db
data/*.xlsx
!data/.gitkeep

# Logs
logs/*.log
logs/*.log.*
!logs/.gitkeep

# Generated report outputs
reports/*.md
reports/*.txt
reports/*.html
reports/research-*
reports/scratch-*
reports/probe-*
reports/debug-*
!reports/.gitkeep

# Local probe / API scratch files
usajobs-codelist-sample.json
probe_workday_sources.py
